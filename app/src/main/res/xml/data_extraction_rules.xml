<!--
   Data extraction rules for API 31+ (backup_rules.xml covers API 30 and below).

   The optional PP-OCRv6 Medium model is a ~77 MB download under the in-app model directory, so it
   is excluded from both cloud backup and device transfer: restoring or transferring it would only
   waste quota on files the app can fetch again (and would leave a half-written set if the transfer
   were partial). The file already lives under no_backup, which Android never backs up — the
   exclusion keeps that guarantee explicit. A copy delivered by Google Play's asset pack lives in
   Play's own storage and is not part of the app's backup either.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pp-ocr" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pp-ocr" />
    </device-transfer>
</data-extraction-rules>
