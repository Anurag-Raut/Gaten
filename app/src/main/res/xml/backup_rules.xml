<!--
   Backup rules for API 30 and below (data_extraction_rules.xml covers API 31+).

   The manga-ocr weights are ~117 MB under filesDir/manga-ocr and are downloaded on demand, so they
   are excluded here and from device transfer: restoring or transferring them would only waste quota
   on files the app can fetch again (and would leave a half-written set if the transfer is partial).
-->
<full-backup-content>
    <exclude domain="file" path="manga-ocr" />
</full-backup-content>
