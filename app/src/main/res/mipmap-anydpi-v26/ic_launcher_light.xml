<!-- The launcher tile the app shows while it is in its own light theme (ui/theme/LauncherIcon.kt):
     the shipped mark, a black ground behind the white G. Its layers are fixed, never
     night-qualified — see values/ic_launcher_theme.xml. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_light_background"/>
    <foreground android:drawable="@drawable/ic_launcher_light_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_light_foreground"/>
</adaptive-icon>
