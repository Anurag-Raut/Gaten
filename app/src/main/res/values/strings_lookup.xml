<resources>

    <!--
      Lookup overlay: the status rail. One line each, one job each. "Reading screen…" is the
      full-screen index still running; "Reading selection…" is the crop the reader just committed.
      The instruction names both ways in — the lasso and the tap — because the tap is invisible.
    -->
    <string name="lookup_reading_screen">Reading screen…</string>
    <string name="lookup_reading_selection">Reading selection…</string>
    <string name="lookup_hint">Circle or tap Japanese text</string>
    <!-- Shown when the index is unavailable: only the lasso can still read text by itself. -->
    <string name="lookup_circle_hint">Circle Japanese text</string>
    <string name="lookup_tap_miss">No text here</string>

    <!-- Lookup overlay: results -->
    <string name="lookup_no_text">No text found</string>
    <string name="lookup_no_words">No dictionary matches</string>
    <string name="lookup_dict_error">Dictionary unavailable</string>
    <!-- The real cause under the failure title; never a class name or an invented one. -->
    <string name="lookup_dict_error_cause">%1$s</string>
    <string name="lookup_select_again">Select again</string>
    <string name="lookup_other_matches">Other matches (%1$d)</string>
    <string name="lookup_base_form">From %1$s</string>
    <string name="lookup_common">Common</string>
    <string name="lookup_also_written">Also written: %1$s</string>
    <string name="lookup_meaning_caption">Meaning</string>
    <string name="lookup_pos_caption">Part of speech</string>
    <string name="lookup_no_meaning">No meaning supplied</string>
    <string name="lookup_toast_copied">Copied</string>

    <!-- Lookup overlay content descriptions -->
    <string name="lookup_cd_close">Close lookup</string>
    <string name="lookup_cd_copy">Copy text</string>
    <string name="lookup_cd_select_again">Select again</string>
    <string name="lookup_cd_scroll_back">Show earlier words</string>
    <string name="lookup_cd_scroll_forward">Show more words</string>
    <string name="lookup_cd_dismiss">Dismiss lookup</string>

    <!--
      Lookup search: the reader's own query, typed in the full-screen cover when the captured text
      was wrong or missing. The field is Home's own search field: the hint is that field's
      placeholder, and the label is what the field is called for a reader who cannot see the
      placeholder — the cover paints no label above it. The limit note is Home's own, and says what
      the limit does — cut a pasted query rather than refusing it.
    -->
    <string name="lookup_search">Search dictionary</string>
    <string name="lookup_search_back">Back to lookup</string>
    <string name="lookup_search_query_label">Search Japanese dictionary</string>
    <string name="lookup_search_query_hint">猫, ねこ, neko...</string>
    <string name="lookup_search_too_long">Searches look at the first 32 characters.</string>
    <!-- A count that still answers the query before the one being typed. -->
    <string name="lookup_search_for_query">%1$s for %2$s</string>
    <!-- A query the dictionary could not answer, while it still holds that query. -->
    <string name="lookup_search_retry">Try again</string>
    <!-- The empty prompt's own words: the heading over the reader's own recent searches, what one of
         those chips does when it is tapped, and the heading over the terms that merely start with the
         query. -->
    <string name="lookup_search_recent">Recent searches</string>
    <string name="lookup_search_common">common</string>
    <string name="lookup_search_from">from %1$s</string>
    <string name="lookup_search_example">Search for %1$s</string>
    <string name="lookup_search_starts_with">Words starting with %1$s</string>
    <!-- Home's own idle caption, drawn under the shared search mark below the recent searches. -->
    <string name="lookup_search_idle_caption">Find your next Japanese word</string>
    <string name="lookup_search_prompt">Enter Japanese or romaji</string>
    <string name="lookup_search_unsupported">English definitions are not searchable</string>
    <!-- What romaji was read as: why "neko" can have an exact ねこ match. -->
    <string name="lookup_search_converted">Searching: %1$s</string>
    <string name="lookup_search_one_result">1 result</string>
    <string name="lookup_search_results">%1$d results</string>
    <string name="lookup_search_capped">Showing up to 24 results</string>

    <!-- How a hit was reached is part of the row itself: the card shows the form it was reached
         through, and says nothing when the query was the spelling. -->
    <string name="lookup_cd_open_entry">Open dictionary entry</string>
    <string name="lookup_entry_opened">Dictionary entry opened</string>

    <!-- A typed entry says where it came from, so the captured source never claims it. -->
    <string name="lookup_searched">Searched: %1$s</string>
    <string name="lookup_original_result">Original lookup</string>
</resources>
