<resources>

    <style name="Theme.Gaten" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- The text stack charges the ellipsis it appends with the text view's *base* paint
             (StaticLayout.calculateEllipsis) while the drawn ellipsis comes from the spanned text, so
             a clamped "Recently looked up" gloss could be laid out wider than its lane and lose the
             leading glyph of its last line. Naming the app face here gives the charge and the drawn
             glyph the same width. Every React Native text already carries the family as a span, so no
             visible text moves. -->
        <item name="android:fontFamily">@font/ibm_plex_sans_jp</item>
        <!-- Default to Gaten's shipped Indigo Light accent so AppCompat's teal never leaks into
             text cursors, selection handles or highlights (including OEM ROMs like ColorOS/OxygenOS
             that tint cursors and handles from theme attributes rather than drawable color filters).
             AccentThemeOverlay overrides these at runtime for the reader's active accent and mode. -->
        <item name="colorAccent">#4338CA</item>
        <item name="colorControlActivated">#4338CA</item>
        <item name="android:colorAccent">#4338CA</item>
        <item name="android:colorControlActivated">#4338CA</item>
        <item name="android:textColorHighlight">#404338CA</item>
    </style>

    <!-- Runtime theme overlays matching Color.kt's AccentRoles primary tones (25% highlight alpha in
         light mode, 30% in dark mode). Applied via AccentThemeOverlay so platform and OEM text
         editors match the reader's chosen accent and mode. -->
    <style name="ThemeOverlay.Gaten.Accent.Indigo.Light" parent="">
        <item name="colorAccent">#4338CA</item>
        <item name="colorControlActivated">#4338CA</item>
        <item name="android:colorAccent">#4338CA</item>
        <item name="android:colorControlActivated">#4338CA</item>
        <item name="android:textColorHighlight">#404338CA</item>
    </style>

