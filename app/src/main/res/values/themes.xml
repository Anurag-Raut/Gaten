<resources>

    <style name="Theme.Gaten" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- For the two activities that exist only to receive a result or to close the Quick Settings
         shade: nothing is drawn, so the app behind them keeps the screen it had. -->
    <style name="Theme.Gaten.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>