<resources>

    <!-- RN's `focusable={false}` deliberately keeps a view focusable for accessibility, so the
         platform's default focus highlight cannot be turned off per view from JS. Gaten draws its
         own focus treatments (PressableScale) and its tab bar must stay clean under a hardware
         keyboard or mouse, so the platform highlight colour is transparent. -->
    <style name="Theme.Gaten" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorControlHighlight">@android:color/transparent</item>
    </style>

    <!-- For the two activities that exist only to receive a result or to close the Quick Settings
         shade: nothing is drawn, so the app behind them keeps the screen it had. -->
    <style name="Theme.Gaten.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>