<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lookup mode: a media projection session the user consents to once per session, and the
         overlay windows drawn over the app being read. SYSTEM_ALERT_WINDOW is the "display over
         other apps" grant; the two foreground-service permissions are what Android 14 and later
         require before a projection may be used at all; POST_NOTIFICATIONS (Android 13+) is what
         lets the service's own notification — the one that says the screen is being captured — be
         seen. Nothing here reads another app's content: the only pixels Gaten ever sees are the ones
         the projection hands to it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reading is offline: the screenshot is recognised on-device, the dictionary is bundled and
         the Anki export is local IPC. INTERNET is here for two optional things, and neither happens
         until the user asks:

         1. Downloading the stylized-text model (ocr/MangaOcrDownloader.kt), when the user taps
            Download on the settings screen, having been shown the size.
         2. WaniKani (wanikani/), once a personal access token is connected on the WaniKani settings
            screen: connecting or rechecking sends the token to api.wanikani.com over HTTPS, and
            opening a kanji or one of its radicals sends that character or that subject id to fetch
            the page (plus cdn.wanikani.com for the SVG of a radical that has no character). Pages
            are cached on the device and read from there offline; nothing is fetched or cached in the
            background.

         The screenshot, the scanned sentence and the other words never leave the device, and no
         WaniKani study progress is requested, kept or shown.

         It also has to be declared rather than removed: ML Kit's transport library and ONNX Runtime
         both ask for it for their analytics and telemetry backends, and stripping it from the merged
         manifest would take the model download with it. ACCESS_NETWORK_STATE comes from
         profileinstaller, ONNX Runtime and androidx; the app reads it to warn when the download would
         run on mobile data. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AnkiDroid is reached through its `flashcards` ContentProvider, which Android 11+ hides from
         other packages unless the package is named here. The provider's READ_WRITE_DATABASE
         permission comes along with the API library. No network is involved: this is on-device IPC. -->
    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gaten"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Gaten">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The app while lookup mode is on: the projection mirror, the frozen frame and the overlay
             windows all live here. The foreground service type is required by Android 14 before the
             projection token may be used, and it is the only thing that keeps the overlay and the
             projection alive while the reader is in another app. -->
        <service
            android:name=".capture.GatenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- A projection token is only ever handed back to an activity, and a Quick Settings tile can
             only close its own shade by starting one: both of these draw nothing, finish at once, and
             exist so the app behind them is never taken off screen. -->
        <activity
            android:name=".capture.CaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Gaten.Transparent" />

        <activity
            android:name=".trigger.TileCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Gaten.Transparent" />

        <!-- Does nothing with notifications: it exists only so MediaSessionManager will hand
             Gaten the active media sessions, which the platform gates on notification access. -->
        <service
            android:name=".media.MediaNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".LookupTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.gaten.app.action.TRIGGER_LOOKUP" />
                <!-- Sent by the home screen after the floating-button switch is toggled. -->
                <action android:name="com.gaten.app.action.FLOATING_BUTTON_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".LookupTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_lookup"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
