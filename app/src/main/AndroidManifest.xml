<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <!-- Reading is offline: the screenshot is recognised on-device, the dictionary is bundled and
         the Anki export is local IPC. INTERNET is here for optional WaniKani (wanikani/) after a
         personal access token is connected on the WaniKani settings screen: connecting or
         rechecking sends the token to api.wanikani.com over HTTPS, and
            opening a kanji or one of its radicals sends that character or that subject id to fetch
            the page (plus cdn.wanikani.com for the SVG of a radical that has no character). Pages
            are cached on the device and read from there offline; nothing is fetched or cached in the
            background.

         The screenshot, the scanned sentence and the other words never leave the device. With a token
         connected, WaniKani study progress is read too - the account's level, the reviews due now and
         over the next 24 hours, and how its items are spread across WaniKani's review stages - for the
         analytics dashboard. It comes from api.wanikani.com, through the same allow-listed read-only
         client, is cached on the device, and is never sent anywhere else.

         It also has to be declared rather than removed: ML Kit's transport library and ONNX Runtime
         both ask for it for their analytics and telemetry backends, and stripping it from the merged
         manifest would take those libraries' integrations with it. ACCESS_NETWORK_STATE comes from
         profileinstaller, ONNX Runtime and androidx. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AnkiDroid is reached through its `flashcards` ContentProvider, which Android 11+ hides from
         other packages unless the package is named here. The provider's READ_WRITE_DATABASE
         permission comes along with the API library. No network is involved: this is on-device IPC. -->
    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gaten"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="true"
        tools:targetApi="31">
        <!-- The React host's activity, with the three window settings React Native expects of it.

             configChanges: these are handled without recreating the activity — ReactActivity hands
             onConfigurationChanged to React, which re-reads the display metrics and announces a
             colour-scheme change to the JS `Appearance` module, so a rotation or a dark-mode switch
             repaints the running app instead of rebuilding the activity (and every saveable screen
             state in it). It is the list the React Native template ships; anything not named here is
             still delivered as a recreation, which MainActivity's react-native-screens fragment
             factory covers.

             windowSoftInputMode: from targetSdk 35 on, Android 15 and later display the app
             edge-to-edge, so the window need not shrink for the keyboard on its own. The one RN
             screen that has a list under a keyboard turns that inset into layout itself (the search
             tab, through KeyboardAvoidingView), so adjustResize — the platform's own layout
             adjustment for the IME, and the precondition that component documents on Android — is
             still what is declared here.

             Measured on a moto g35 5G (Android 15, gesture navigation) after installing this build:
             with the keyboard up the app's own root view still spans the full 1080×2400 — the window
             is *not* resized, so adjustResize alone changes nothing, and the inset is turned into
             layout in JS instead. The search screen wraps its whole body in KeyboardAvoidingView
             (`behavior="padding"`, no `keyboardVerticalOffset` — it is the scene's top child, so its
             frame is already the rectangle that calculation wants): with the keyboard up (top edge
             measured at y=1591) the results list's own bounds become [0,448][1080,1591] — it ends
             exactly at the keyboard's top edge — and with the keyboard hidden they return to
             [0,448][1080,2200], the full scene, so nothing is padded twice.

             The launcher reaches this permanent component through LauncherActivity. It stays
             enabled for the lookup overlay, Quick Settings tile and settings deep links too. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Gaten"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- Keep the alias's task separate from MainActivity. Android may finish a disabled
             alias's activity/task even with DONT_KILL_APP; this dispatcher finishes before the
             theme/icon sync on MainActivity's resume. NoDisplay prevents an extra launch screen. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Stable component names preserve Android's enabled-state overrides across updates.
             Fully qualified targets also preserve the com.gaten.app namespace when the manifest
             package is renamed to the installed applicationId (com.gaten). -->
        <activity-alias
            android:name="com.gaten.app.LauncherIconSystem"
            android:targetActivity="com.gaten.app.LauncherActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.gaten.app.LauncherIconLight"
            android:targetActivity="com.gaten.app.LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_light"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.gaten.app.LauncherIconDark"
            android:targetActivity="com.gaten.app.LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_dark"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".GatenAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Does nothing with notifications: it exists only so MediaSessionManager will hand
             Gaten the active media sessions, which the platform gates on notification access. -->
        <service
            android:name=".media.MediaNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".LookupTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.gaten.app.action.TRIGGER_LOOKUP" />
                <!-- Sent by the home screen after the floating-button switch is toggled. -->
                <action android:name="com.gaten.app.action.FLOATING_BUTTON_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".LookupTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_lookup"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
