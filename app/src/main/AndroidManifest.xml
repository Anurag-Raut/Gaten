<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <!-- Reading is offline: the screenshot is recognised on-device, the dictionary is bundled and
         the Anki export is local IPC. INTERNET is here for one thing only — downloading the optional
         manga-ocr model (ocr/MangaOcrDownloader.kt) when the user taps Download on the settings
         screen, having been shown the size. Nothing else in the app makes a request, and nothing
         downloads without that tap.

         It also has to be declared rather than removed: ML Kit's transport library and ONNX Runtime
         both ask for it for their analytics and telemetry backends, and stripping it from the merged
         manifest would take the model download with it. ACCESS_NETWORK_STATE comes from
         profileinstaller, ONNX Runtime and androidx; the app reads it to warn when the download would
         run on mobile data. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AnkiDroid is reached through its `flashcards` ContentProvider, which Android 11+ hides from
         other packages unless the package is named here. The provider's READ_WRITE_DATABASE
         permission comes along with the API library. No network is involved: this is on-device IPC. -->
    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gaten"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Gaten">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GatenAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".LookupTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.gaten.app.action.TRIGGER_LOOKUP" />
                <!-- Sent by the home screen after the floating-button switch is toggled. -->
                <action android:name="com.gaten.app.action.FLOATING_BUTTON_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".LookupTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_lookup"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
