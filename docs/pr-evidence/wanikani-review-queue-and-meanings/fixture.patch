@@ -0,0 +1,234 @@
+/**
+ * Gaten — evidence fixture root (not part of the app; see README.md).
+ *
+ * Mounts the *production* WaniKaniReview screen over the *production* review store, with one session
+ * handed in and nothing else faked: every entry, judgement, refusal, phase and continue below is the
+ * real store's own code, so what is photographed here is what the app does.
+ *
+ * The same file is built into both builds of the pair. Where the two builds differ — the drawn lead
+ * of a subject's pair, the kana refusal, the meaning detail — the difference is the builds' own code
+ * meeting identical fixture input, which is the point of a shared harness.
+ *
+ * Three things make it safe:
+ *  - the session is installed in the store's own paused-session slot, so `startReviews()` publishes
+ *    it instead of reading the review queue (no token, no network, no account);
+ *  - `submitWaniKani` is replaced with a no-op before anything can reach it — the only path that
+ *    posts to WaniKani cannot fire even by mistake;
+ *  - the subject is synthetic (`仮語`, subject id 9001), two-part like a Vocabulary card, with a
+ *    reading to quiz, so nothing on screen claims to be a real review.
+ */
+import React, {useEffect, useRef, useState} from "react";
+import {Pressable, StyleSheet, Text, View} from "react-native";
+import {GestureHandlerRootView} from "react-native-gesture-handler";
+import {SafeAreaProvider} from "react-native-safe-area-context";
+import {KeyboardProvider} from "react-native-keyboard-controller";
+import {ThemeProvider} from "../src/rn/ui/theme";
+import {WaniKaniReview} from "../src/rn/ui/review/WaniKaniReview";
+import {
+  buildWaniKaniPromptOrder,
+  reviewStore,
+  type WaniKaniPrompt,
+  type WaniKaniSession,
+} from "../src/rn/ui/review/review-store";
+import type {WaniKaniReviewItem} from "../src/rn/native/GatenWaniKani";
+
+/**
+ * A synthetic Vocabulary subject: two parts, so the screen asks a meaning and quizzes a reading, and
+ * four accepted meanings, so the detail tab has alternates to show beside the primary one. It is not
+ * a WaniKani subject — the characters are a non-word and the id is outside the content range — so a
+ * still can never be mistaken for a real review of real content.
+ */
+const SUBJECT: WaniKaniReviewItem = {
+  subjectId: 9001,
+  type: "vocabulary",
+  characters: "仮語",
+  meanings: ["language", "dialect", "speech", "tongue"],
+  primaryMeaning: "language",
+  readings: ["ことば"],
+  primaryReading: "ことば",
+  level: 28,
+  meaningMnemonic: "Fixture subject: synthetic, so no mnemonic is claimed for it.",
+  readingMnemonic: "",
+  contextSentences: [],
+};
+
+/**
+ * The pair's order, from the production builder. Both draws are pinned so a scene is the same queue
+ * on every launch; on a build that asks a meaning first whatever it is given, the same call yields
+ * the meaning-first order, which is exactly the before-state of the drawn-lead change.
+ */
+const meaningFirst = (): WaniKaniPrompt[] => buildWaniKaniPromptOrder([2], () => 0.9);
+const readingFirst = (): WaniKaniPrompt[] => buildWaniKaniPromptOrder([2], () => 0.1);
+
+/** A session stopped at `order[cursor]`, with whatever is already in the field. */
+function sessionWith(order: WaniKaniPrompt[], cursor: number, entry: string): WaniKaniSession {
+  const at = order[cursor];
+  return {
+    items: [SUBJECT],
+    order,
+    cursor,
+    totalParts: order.length,
+    doneParts: cursor,
+    index: at.index,
+    part: at.part,
+    entry,
+    entryRefused: false,
+    incorrectMeaning: 0,
+    incorrectReading: 0,
+    wrong: [{meaning: 0, reading: 0}],
+    feedback: null,
+    retrying: false,
+    phase: "answering",
+    failure: null,
+    authRejected: false,
+  };
+}
+
+/**
+ * The scenes. Each one is the same three lines — install, then let the store judge if the scene is
+ * about a judgement — so a scene renders whatever that build does with that input:
+ *
+ *  - `meaning`      the meaning prompt, open, for the live wrong-answer → Done → retry path;
+ *  - `reading-first` the same pair with the reading drawn first (a meaning-first build shows a
+ *                   meaning here): the drawn-lead change, and the reading prompt for item 2;
+ *  - `mixed-input`  the reading prompt with `sひゅう` in the field, judged by the store: a build
+ *                   without the kana rule answers `Incorrect`, a build with it refuses the entry;
+ *  - `wrong-stop`   the meaning prompt with a wrong answer already judged, which is where the detail
+ *                   tab is opened from.
+ */
+const scenes = {
+  meaning: () => sessionWith(meaningFirst(), 0, ""),
+  "reading-first": () => sessionWith(readingFirst(), 0, ""),
+  "mixed-input": () => sessionWith(meaningFirst(), 1, "sひゅう"),
+  "wrong-stop": () => sessionWith(meaningFirst(), 0, "zzz"),
+};
+
+type Scene = keyof typeof scenes;
+
+/** The scenes the store itself judges when they are installed; the others stay open to be driven. */
+const judgedOnInstall: Scene[] = ["mixed-input", "wrong-stop"];
+
+/**
+ * The store seen from outside: the members this fixture reaches for. TypeScript marks them private,
+ * which is a compile-time idea only — reaching in here keeps every transition the real one instead
+ * of re-implementing the store's phase machine in the harness.
+ */
+type StoreInternals = {
+  pausedReview: WaniKaniSession | null;
+  submitWaniKani: () => void;
+  enterWaniKaniReview: () => Promise<void>;
+};
+
+export function ReviewFixture() {
+  const [state, setState] = useState(() => reviewStore.getState());
+  const [scene, setScene] = useState<Scene>("meaning");
+  const [unavailable, setUnavailable] = useState<string | null>(null);
+  const installed = useRef(false);
+
+  // The screen renders from the store, exactly as the page's own hook does — without that hook's
+  // AppState lifecycle, which would ask the network for counts this fixture must not touch.
+  useEffect(() => {
+    const subscription = reviewStore.subscribe(setState);
+    return () => subscription.remove();
+  }, []);
+
+  useEffect(() => {
+    if (installed.current) return;
+    installed.current = true;
+    const internals = reviewStore as unknown as StoreInternals;
+    // Fail closed: if a rename has moved either member, nothing below runs — no session is installed
+    // and `startReviews` is never called, so not even the queue read can fire.
+    if (
+      typeof internals.submitWaniKani !== "function" ||
+      typeof internals.enterWaniKaniReview !== "function"
+    ) {
+      setUnavailable("the store's private stub targets are not functions");
+      return;
+    }
+    // Nothing may be posted to WaniKani from this build, whatever is typed.
+    internals.submitWaniKani = () => {};
+    // Belt and braces: the queue read is the other door, and it is the one `startReviews` would open
+    // if the paused session were ever not published. Closing it leaves the worst case a fallback
+    // card, never a request.
+    internals.enterWaniKaniReview = () => Promise.resolve();
+    internals.pausedReview = scenes.meaning();
+    // With a paused session this publishes the step and reads no queue.
+    reviewStore.startReviews();
+  }, []);
+
+  const show = (scene: Scene) => {
+    setScene(scene);
+    const internals = reviewStore as unknown as StoreInternals;
+    internals.pausedReview = scenes[scene]();
+    reviewStore.startReviews();
+    if (judgedOnInstall.includes(scene)) reviewStore.wkCheck();
+  };
+
+  const step = state.step;
+  return (
+    <GestureHandlerRootView style={styles.root}>
+      <SafeAreaProvider>
+        <KeyboardProvider statusBarTranslucent navigationBarTranslucent>
+          <ThemeProvider>
+            <View style={styles.scenes}>
+              <Text style={styles.scenesLabel}>fixture</Text>
+              {(Object.keys(scenes) as Scene[]).map((name) => (
+                <Pressable
+                  key={name}
+                  accessibilityRole="button"
+                  onPress={() => show(name)}
+                  style={[styles.sceneButton, name === scene && styles.sceneButtonOn]}
+                >
+                  <Text style={[styles.sceneText, name === scene && styles.sceneTextOn]}>
+                    {name}
+                  </Text>
+                </Pressable>
+              ))}
+            </View>
+            <View style={styles.screen}>
+              {step.kind === "wkReview" ? (
+                <WaniKaniReview
+                  session={step.session}
+                  busy={state.busy}
+                  onBack={() => {}}
+                  onEntry={(text) => reviewStore.wkEntry(text)}
+                  onCheck={() => reviewStore.wkCheck()}
+                  onContinue={() => reviewStore.wkContinue()}
+                  onRetrySubmit={() => {}}
+                />
+              ) : (
+                <View style={styles.fallback}>
+                  <Text style={styles.fallbackText}>
+                    {unavailable == null
+                      ? "fixture: no review session - the paused session install did not take"
+                      : `fixture: not installed - ${unavailable}`}
+                  </Text>
+                </View>
+              )}
+            </View>
+          </ThemeProvider>
+        </KeyboardProvider>
+      </SafeAreaProvider>
+    </GestureHandlerRootView>
+  );
+}
+
+const styles = StyleSheet.create({
+  root: {flex: 1},
+  screen: {flex: 1},
+  scenes: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 6,
+    paddingHorizontal: 8,
+    paddingVertical: 6,
+    backgroundColor: "#101014",
+  },
+  scenesLabel: {color: "#8a8f98", fontSize: 11, marginRight: 2},
+  sceneButton: {paddingHorizontal: 8, paddingVertical: 4, borderRadius: 6, backgroundColor: "#22242c"},
+  sceneButtonOn: {backgroundColor: "#4d5bd6"},
+  sceneText: {color: "#c8ccd4", fontSize: 11},
+  sceneTextOn: {color: "#ffffff", fontWeight: "700"},
+  fallback: {flex: 1, alignItems: "center", justifyContent: "center", padding: 24},
+  fallbackText: {color: "#f5c2c7", textAlign: "center"},
+});
