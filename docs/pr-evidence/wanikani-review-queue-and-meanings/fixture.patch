+/**
+ * Evidence fixture entry — NOT part of the app, never imported by it.
+ *
+ * The React Native Gradle plugin resolves the bundle's entry file in this order (PathUtils.kt):
+ * the `ENTRY_FILE` environment variable, then `react { entryFile }` in app/build.gradle.kts, then
+ * `index.android.js`, then `index.js`. So this entry is chosen by the environment alone, for one
+ * build, with no production file touched:
+ *
+ *   ENTRY_FILE=.evidence-fixture/index.js ./gradlew :app:assembleDebug -PreactNativeArchitectures=x86_64
+ *
+ * `debuggableVariants` is already empty in app/build.gradle.kts, so the debug variant bundles its JS
+ * into the APK and needs no Metro dev server — the fixture APK is self-contained.
+ */
+import {AppRegistry} from "react-native";
+import {ReviewFixture} from "./ReviewFixture";
+
+// MainActivity mounts the component named "Gaten", so the fixture takes that name for this build.
+// The production entry's second component, "GatenLookupSheet", is deliberately not registered: this
+// build never mounts the lookup overlay's window.
+AppRegistry.registerComponent("Gaten", () => ReviewFixture);
