# Gradle / Kotlin
.gradle/
.kotlin/
build/
/captures
.externalNativeBuild
.cxx
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Build outputs
*.apk
*.aab
*.dm

# Generated dictionary: build it with tools/build_jmdict_db.py
app/src/main/assets/db/jmdict.sqlite

# Generated example sentences: build it with tools/build_examples_db.py
app/src/main/assets/db/examples.sqlite

# Generated Remembering the Kanji reference: build it with tools/build_rtk_db.py.
# Generated rather than committed because the bundled prose is third-party content whose
# redistribution rights have not been cleared (docs/jp-prototype/rtk/DATA.md).
app/src/main/assets/db/rtk.sqlite

# manga-ocr model: fetched by the build into the assets every variant bundles, or by
# tools/fetch_manga_ocr.sh. ~117 MB of weights, gitignored like the dictionary databases.
app/src/main/assets/manga-ocr/

# Device evidence screenshots stay out of history
docs/jp-prototype/**/*.png
docs/jp-prototype/**/*.jpg

# Python bytecode from the dictionary tooling
__pycache__/
node_modules/
