.DS_Store

# Build outputs
*.apk
*.aab
*.dm

# Generated dictionary: build it with tools/build_jmdict_db.py
app/src/main/assets/db/jmdict.sqlite

# Optional manga-ocr model: downloaded by the debug build with -PbundleMangaOcr=true, or by
# tools/fetch_manga_ocr.sh. ~117 MB of weights, debug-only, never part of a release APK.
app/src/debug/assets/manga-ocr/

# meiki text-line detector: fetched by the fetchMeikiModel Gradle task into the app's assets tree
# (shipped in every APK as meiki/detect.onnx). ~41 MB of weights, never committed.
app/models/

# Device evidence screenshots stay out of history
docs/jp-prototype/**/*.png
docs/jp-prototype/**/*.jpg
